# окружение
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.DS_Store
.ipynb_checkpoints/

# логгеры
wandb/
.hydra/
outputs/

# скачанные данные и внешний код
datasets/*
ext/*
!datasets/.gitkeep
!datasets/*.json
!ext/.gitkeep

# тяжёлые веса; код, логи, tmp, HTML и рисунки остаются в git
*.pt
*.pth
*.ckpt
*.safetensors
*.bin

# секреты
.env
*.key

# тяжёлые артефакты lerobot
outputs/
eval_logs/

# mlflow (локальный трекинг)
mlflow.db
mlruns/
mlartifacts/

# logs/, runs/ и tmp/ содержат доказательства и отслеживаются

# служебные инструкции агентов
AGENTS.md
CLAUDE.md

# crash-лог MuJoCo
MUJOCO_LOG.TXT

# сырые eval-логи прогонов: агрегаты вшиты в runs/report.html
tmp/*.log
runs/**/*.jsonl
runs/**/tokenizer/

# автоматизация и wiring-проверки: проверяющим не нужны
tmp/

# вспомогательные setup-скрипты под конкретные машины
setup_gpu.sh
setup_macos_libero.sh
setup.sh
run_preliminary.py

# журнал работы и вспомогательные скрипты: проверяющему не нужны
NOTES.md
tmp/
